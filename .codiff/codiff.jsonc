{
  "$schema": "https://raw.githubusercontent.com/nkzw-tech/codiff/main/src/config/codiff-config.schema.json",
  "keymap": {
    "closeSearch": "Escape",
    "commandBar": "Mod+k",
    "diffSearch": "Mod+f",
    "discardComment": "Escape",
    "fileFilter": "Mod+p",
    "nextHunk": [
      "Ctrl+ArrowDown",
      "j"
    ],
    "nextSearchMatch": "Enter",
    "openFile": "Mod+k",
    "prevHunk": [
      "Ctrl+ArrowUp",
      "k"
    ],
    "prevSearchMatch": "Shift+Enter",
    "shortcutsHelp": "Shift+?",
    "submitComment": "Mod+Enter",
    "toggleMenuBar": "Mod+Alt+m",
    "toggleSidebar": "Mod+b",
    "toggleWordWrap": "Alt+z"
  },
  "settings": {
    "agentBackend": "codex",
    "claudeModel": "claude-haiku-4-5",
    "codeFontFamily": "",
    "codeFontSize": 13,
    "copyCommentsOnClose": false,
    "diffStyle": "split",
    "editorCommand": "",
    "lastRepositoryPath": "/home/dalton/dev/bbk/abacus-platform/abacus-tasks",
    "openAIModel": "gpt-5.3-codex-spark",
    "showOutdated": false,
    "showWhitespace": false,
    "theme": "system",
    "wordWrap": false
  }
}
