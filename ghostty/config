# Font configuration
font-family = "Berkeley Mono"
font-size = 13

# Clipboard configuration
clipboard-read = allow
clipboard-write = allow

font-codepoint-map = U+f101-U+f25c=nonicons

# Font features and modifications
font-feature = -liga
adjust-cell-height = 25%
# adjust-cell-height = 40%
# adjust-cell-width = 10%

# Cursor configuration
cursor-style = block
cursor-style-blink = false

# Window configuration
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
# window-padding-color = extend
# "false"/"none" makes the window borderless on macOS, which breaks tiling WMs
# (OmniWM/yabai can't manage it); "auto" = normal window on mac (titlebar still
# hidden via macos-titlebar-style), server-side decorations under Hyprland
window-decoration = auto

# macOS specific
macos-option-as-alt = true
macos-titlebar-style = hidden

# Background opacity
background-opacity = 1.0

# Shell integration
# shell-integration = true
# shell-integration-features = cursor,sudo,title

# Clipboard
clipboard-read = allow
clipboard-write = allow

# Theme
theme = Miasma

# Shaders
custom-shader = ./shaders/cursor_blaze_tapered_themed.glsl
# custom-shader = ./shaders/blaze_sparks_themed.glsl
# custom-shader = ./shaders/shake.glsl
# custom-shader = ./shaders/crt.glsl
# custom-shader = ./shaders/bloom025.glsl
# custom-shader = ./shaders/tft.glsl
# custom-shader = ./shaders/bettercrt.glsl
# custom-shader = ./shaders/bloom025.glsl
# keybind = shift+enter=text:\x1b\r
keybind = shift+enter=text:\n
keybind = alt+backspace=text:\x1b\x7f
# Quake-style dropdown terminal (replaces OmniWM's quake terminal under AeroSpace)
keybind = global:opt+grave_accent=toggle_quick_terminal

# keybind = ctrl+shift+j=write_screen_file:paste

