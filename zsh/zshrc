# Shared zsh configuration. Keep machine-specific configuration in ~/.zshrc.local.

HISTFILE="${ZDOTDIR:-$HOME}/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt append_history share_history hist_ignore_dups hist_reduce_blanks

typeset -U path PATH
path=(
  "$HOME/bin"
  "$HOME/.local/bin"
  "$HOME/.local/share/bob/nvim-bin"
  "$HOME/go/bin"
  "$HOME/.npm-global/bin"
  "$HOME/n/bin"
  "$HOME/.bun/bin"
  "$HOME/.cargo/bin"
  "$HOME/.deno/bin"
  "$HOME/.opencode/bin"
  "$HOME/.fly/bin"
  "$HOME/.local/share/pnpm"
  /usr/local/bin
  /opt/homebrew/bin
  /opt/homebrew/sbin
  $path
)
export PATH

export EDITOR="${EDITOR:-nvim}"
export VISUAL="${VISUAL:-$EDITOR}"

zsh_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
[[ -d "$zsh_cache_dir" ]] || mkdir -p "$zsh_cache_dir"
zsh_compdump="$zsh_cache_dir/zcompdump-$ZSH_VERSION"

if [[ -d "$HOME/.oh-my-zsh" ]]; then
  export ZSH="$HOME/.oh-my-zsh"
  ZSH_THEME="robbyrussell"
  ZSH_COMPDUMP="$zsh_compdump"
  plugins=(git zsh-vi-mode zsh-system-clipboard fzf-tab)
  source "$ZSH/oh-my-zsh.sh"
else
  autoload -Uz compinit
  compinit -d "$zsh_compdump"
fi

if (( $+commands[eza] )); then
  alias ls='eza --color=auto --group-directories-first --icons=auto'
  alias ll='eza -la --group-directories-first --icons=auto'
  alias l='eza -bGF --header --git --group-directories-first --icons=auto'
  alias la='eza --long --all --group --group-directories-first'
  alias lt='eza --tree --level=2 --icons=auto'
else
  alias ll='ls -lah'
  alias la='ls -A'
fi

alias n='nvim'
alias c='CLAUDE_CODE_NO_FLICKER=1 claude --allow-dangerously-skip-permissions'
alias lzd='lazydocker'
alias lzg='lazygit'

if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh --cmd cd)"
fi

if (( $+commands[fzf] )); then
  if fzf --zsh >/dev/null 2>&1; then
    source <(fzf --zsh)
  else
    for fzf_integration in \
      /usr/share/doc/fzf/examples/key-bindings.zsh \
      /usr/share/doc/fzf/examples/completion.zsh \
      /opt/homebrew/opt/fzf/shell/key-bindings.zsh \
      /opt/homebrew/opt/fzf/shell/completion.zsh; do
      [[ -r "$fzf_integration" ]] && source "$fzf_integration"
    done
  fi
fi

if (( $+commands[try] )) && [[ -d "$HOME/dev/experiments" ]]; then
  eval "$(try init "$HOME/dev/experiments")"
fi

if [[ -f "$HOME/.zshrc.local" ]]; then
  source "$HOME/.zshrc.local"
fi
